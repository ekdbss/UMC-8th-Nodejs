// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  sid       String   @unique  // Session 식별
  data      String   @db.VarChar(512) // 사용자 정보를 자유롭게 저장
  expiresAt DateTime @map("expires_at") // Session의 만료 시간 설정 (보통 1주일)

  @@map("session")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique(map: "email") @db.VarChar(255)
  name          String    @db.VarChar(100)
  gender        String    @db.VarChar(15)
  birth         DateTime  @db.Date
  address       String    @db.VarChar(255)
  detailAddress String?   @map("detail_address") @db.VarChar(255)
  phoneNumber   String    @map("phone_number") @db.VarChar(15)
  status        String    @db.VarChar(15)
  point         Int       @default(0)
  inactiveDate  DateTime? @map("inactive_date")

  userFavorCategories UserFavorCategory[]
  reviews             UserStoreReview[] // UserStoreReview와의 관계 추가
  userMissions        UserMission[]
  UserAgreement       UserAgreement[]

  @@map("user")
}

model Terms {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(50)
  body      String   @db.Text
  optional  Boolean
  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @updatedAt @db.DateTime(6)

  userAgreements UserAgreement[]

  @@map("terms")
}

model UserAgreement {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  termsId   Int      @map("terms_id")
  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @updatedAt @db.DateTime(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms Terms @relation(fields: [termsId], references: [id], onDelete: Cascade)

  @@map("user_agreements")
}

model FoodCategory {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  userFavorCategories UserFavorCategory[]

  @@map("food_category")
}

model UserFavorCategory {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int          @map("user_id")
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId Int          @map("food_category_id")

  @@index([foodCategoryId], map: "f_category_id")
  @@index([userId], map: "user_id")
  @@map("user_prefer_category")
}

model Region {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(100)
  stores Store[]

  @@map("region")
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  regionId  Int      @map("region_id")
  address   String   @db.VarChar(100)
  rating    Float    @db.Float
  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @updatedAt @db.DateTime(6)

  region   Region            @relation(fields: [regionId], references: [id], onDelete: Cascade)
  reviews  UserStoreReview[] // Store와 연결된 리뷰들
  missions Mission[] // Store와 연결된 미션들

  @@map("store")
}

model Mission {
  id        Int      @id @default(autoincrement())
  storeId   Int // store_id
  name      String   @db.VarChar(100)
  deadline  DateTime
  criterion Int // 미션 기준
  reward    Int // 미션 보상
  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @updatedAt @db.DateTime(6)

  store        Store         @relation(fields: [storeId], references: [id]) // store와의 관계 설정
  userMissions UserMission[]

  @@map("mission") // 테이블 이름을 mission으로 지정
}

model UserMission {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  missionId Int      @map("mission_id")
  status    String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @updatedAt @db.DateTime(6)

  // 관계 설정
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("user_mission")
}

model UserStoreReview {
  id      Int    @id @default(autoincrement())
  storeId Int
  userId  Int
  content String
  
  store   Store  @relation(fields: [storeId], references: [id]) // Store와의 관계
  user    User   @relation(fields: [userId], references: [id]) // User와의 관계

  @@map("user_review")
}
